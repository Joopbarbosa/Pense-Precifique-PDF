# pense-precifique-pdf — variáveis de ambiente

PORT=3001

# Origens permitidas a chamar este serviço (frontend local + backend interno Docker)
ALLOWED_ORIGINS=http://localhost:3000,http://pense-precifique-backend:8080

# Timeout de renderização (segundos) — acima disso, retorna 408
RENDER_TIMEOUT_SECONDS=30

# Limite de páginas por documento — acima disso, retorna 413
MAX_PAGINAS=10
